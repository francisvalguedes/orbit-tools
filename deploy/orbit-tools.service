# Serviço systemd do orbit-tools, com os valores padrão de docs/implantacao_systemd.md (usuário mirante, código em
# /opt/orbit-tools). Com outros nomes, troque ao copiar, como no guia:
#   sed -e 's/mirante/<usuário>/g' -e 's#/opt/orbit-tools#<pasta>#g' deploy/orbit-tools.service \
#     | sudo tee /etc/systemd/system/orbit-tools.service > /dev/null
#   sudo systemctl daemon-reload && sudo systemctl enable --now orbit-tools
#
# Escuta só na própria máquina; um proxy reverso (nginx) publica na rede. Para servir direto, use --host 0.0.0.0.
# Para mudar a porta: sudo systemctl edit --full orbit-tools.

[Unit]
Description=orbit-tools (elementos orbitais, passagens, trajetórias para rastreio, conversões)
After=network-online.target
Wants=network-online.target

[Service]
User=mirante
Group=mirante
WorkingDirectory=/opt/orbit-tools/backend
# Configuração da instalação (opcional): proxy, limites, outro caminho para locais e radares. Fora do git e
# legível só pelo root, porque a URL do proxy pode ter senha. Modelo em deploy/orbit-tools.env.example.
EnvironmentFile=-/etc/orbit-tools/orbit-tools.env
# Um processo só: a manutenção (EOP, SATCAT, limpeza de caches) e o limite de consultas ao Space-Track ficam
# na memória do processo. As requisições já rodam em paralelo nas threads do uvicorn.
ExecStart=/opt/orbit-tools/backend/.venv/bin/uvicorn orbit_tools.api.main:app --host 127.0.0.1 --port 8010
Restart=always
RestartSec=3

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
# Única pasta gravável: caches (Celestrak, SATCAT, EOP), conjuntos de elementos e ZIPs gerados.
# Deve existir antes de o serviço iniciar; se mudar ORBIT_DATA_DIR, use o mesmo caminho aqui.
ReadWritePaths=/opt/orbit-tools/dados

[Install]
WantedBy=multi-user.target
