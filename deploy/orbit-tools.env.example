# Configuração do serviço orbit-tools. Copie para /etc/orbit-tools/orbit-tools.env e proteja:
#   sudo install -d -m 755 /etc/orbit-tools
#   sudo install -m 600 deploy/orbit-tools.env.example /etc/orbit-tools/orbit-tools.env
# Todas as linhas são opcionais. Depois de editar: sudo systemctl restart orbit-tools

# Locais e radares oferecidos a todos os usuários: por padrão, config/local/locais.csv e config/local/radares.csv
# dentro do repositório (pasta no .gitignore; ver config/README.md). Só para usar arquivos em outro lugar:
#ORBIT_SITES_CSV=/etc/orbit-tools/locais.csv
#ORBIT_RADARS_CSV=/etc/orbit-tools/radares.csv

# Proxy para o servidor acessar Celestrak, Space-Track e IERS (se a rede exigir)
#HTTPS_PROXY=http://usuario:senha@proxy.exemplo:3128
#NO_PROXY=localhost,127.0.0.1

# Pasta de dados (padrão: dados/ na raiz do repositório). Se mudar, mude também o ReadWritePaths do serviço.
#ORBIT_DATA_DIR=/opt/orbit-tools/dados

# Limites (valores padrão). Atenção: no systemd, comentário no fim da linha vira parte do valor.
# Janela da busca de passagens, em dias
#ORBIT_MAX_SEARCH_DAYS=10
# Custo da busca, objetos × dias (~1 s a cada 1 000)
#ORBIT_MAX_OBJECT_DAYS=60000
# Pontos por ZIP de trajetórias
#ORBIT_MAX_EXPORT_POINTS=30000000
# Conjuntos de elementos por requisição
#ORBIT_MAX_ELEMENTS=40000
# NORADs por consulta ao Space-Track
#ORBIT_MAX_SPACETRACK_IDS=650
